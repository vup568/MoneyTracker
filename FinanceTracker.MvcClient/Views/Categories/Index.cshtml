@model List<CategoryViewModel>

@{
    ViewData["Title"] = "Categories Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Categories Management</h2>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-circle"></i> Add New Category
        </button>
    </div>

    <!-- Alert for JS Fetch actions -->
    <div id="actionAlert" class="alert d-none" role="alert"></div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 10%;">ID</th>
                        <th scope="col" style="width: 30%;">Category Name</th>
                        <th scope="col" style="width: 45%;">Description</th>
                        <th scope="col" style="width: 15%;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="categoriesTableBody">
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td>@item.Id</td>
                            <td>@item.CategoryName</td>
                            <td>@item.CategoryDescription</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1" onclick="openEditModal(@item.Id)">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteCategory(@item.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Mới Category -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createCategoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createCategoryForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="categoryName" required>
                    </div>
                    <div class="mb-3">
                        <label for="categoryDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="categoryDescription" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Category -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCategoryModalLabel">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCategoryForm">
                <input type="hidden" id="editCategoryId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editCategoryName" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="editCategoryName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editCategoryDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="editCategoryDescription" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const API_BASE_URL = "https://localhost:7271/api/categories";

        // TODO: TASK 2 - WRITE THE JAVASCRIPT FETCH DELETE FUNCTION HERE
        // It should call API DELETE with the category ID
        // If successful, remove the row from DOM and show success alert
                async function deleteCategory(id) {
            if (confirm("Are you sure you want to delete this category?")) {
                try {
                    // 1. Gọi API xóa
                    const response = await fetch(`${API_BASE_URL}/${id}`, {
                        method: 'DELETE'
                    });

                    // 2. Kiểm tra kết quả trả về từ API
                    if (response.ok) {
                        // 3. Xóa dòng tương ứng trên giao diện
                        const row = document.getElementById(`row-${id}`);
                        if (row) {
                            row.remove();
                        }
                        alert("Deleted successfully!");
                    } else {
                        alert("Failed to delete category.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("An error occurred.");
                }
            }
        }

                // Xử lý sự kiện Submit Form tạo mới Category
        document.getElementById('createCategoryForm').addEventListener('submit', async function(e) {
            e.preventDefault(); // 1. Chặn hành vi reload trang mặc định

            // Lấy dữ liệu từ các ô input trong Form
            const name = document.getElementById('categoryName').value;
            const description = document.getElementById('categoryDescription').value;

            try {
                // 2. Gửi request POST tới API kèm Body là JSON string
                const response = await fetch(API_BASE_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json' // Báo cho API biết ta gửi JSON
                    },
                    body: JSON.stringify({
                        //stringify -> serialize ( change object to Json string ), use for send via http, save to file, database, Local Storage
                        categoryName: name,
                        categoryDescription: description
                    })
                });

                if (response.ok) {
                    // API trả về đối tượng vừa tạo dạng JSON (kèm ID tự sinh từ DB)
                    const newCategory = await response.json();

                    // 3. Tự động chèn thêm 1 dòng <tr> mới vào cuối bảng DOM
                    const tbody = document.getElementById('categoriesTableBody');
                    const newRow = `
                        <tr id="row-${newCategory.id}">
                            <td>${newCategory.id}</td>
                            <td>${newCategory.categoryName}</td>
                            <td>${newCategory.categoryDescription ?? ''}</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1" onclick="openEditModal(${newCategory.id})">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteCategory(${newCategory.id})">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', newRow);
                    //Giúp chèn thêm HTML dòng mới vào cuối bảng cực kỳ nhanh và mượt mà, 
                    // không làm mất trạng thái hay reload lại các phần tử cũ trong DOM.

                    // 4. Reset các ô nhập của Form về rỗng
                    document.getElementById('createCategoryForm').reset();

                    // 5. Đóng Modal Bootstrap
                    const modalEl = document.getElementById('createCategoryModal');
                    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.hide();

                    alert("Added new category successfully!");
                } else {
                    const errorText = await response.text();
                    alert("Failed to add category: " + errorText);
                }
            } catch (error) {
                console.error("Error:", error);
                alert("An error occurred while creating category.");
            }
        });

        // Hàm mở Modal Sửa và đổ dữ liệu
        async function openEditModal(id) {
            try {
                // 1. Gọi API lấy chi tiết Category theo ID
                const response = await fetch(`${API_BASE_URL}/${id}`);
                if (response.ok) {
                    const category = await response.json();

                    // 2. Điền dữ liệu vào form sửa
                    document.getElementById('editCategoryId').value = category.id;
                    document.getElementById('editCategoryName').value = category.categoryName;
                    document.getElementById('editCategoryDescription').value = category.categoryDescription ?? '';

                    // 3. Hiển thị modal
                    const modalEl = document.getElementById('editCategoryModal');
                    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.show();
                } else {
                    alert("Failed to retrieve category details.");
                }
            } catch (error) {
                console.error("Error:", error);
                alert("An error occurred while loading category details.");
            }
        }

        // Xử lý sự kiện Submit Form cập nhật Category
        document.getElementById('editCategoryForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const id = document.getElementById('editCategoryId').value;
            const name = document.getElementById('editCategoryName').value;
            const description = document.getElementById('editCategoryDescription').value;

            try {
                // Gửi request PUT cập nhật lên API
                const response = await fetch(`${API_BASE_URL}/${id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        id: parseInt(id),
                        categoryName: name,
                        categoryDescription: description
                    })
                });

                if (response.ok) {
                    // Cập nhật dòng hiển thị trên bảng DOM trực tiếp mà không cần reload
                    const row = document.getElementById(`row-${id}`);
                    if (row) {
                        row.cells[1].innerText = name;
                        row.cells[2].innerText = description;
                    }

                    // Đóng Modal
                    const modalEl = document.getElementById('editCategoryModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    alert("Updated category successfully!");
                } else {
                    const errorText = await response.text();
                    alert("Failed to update category: " + errorText);
                }
            } catch (error) {
                console.error("Error:", error);
                alert("An error occurred while updating category.");
            }
        });



    </script>
}
