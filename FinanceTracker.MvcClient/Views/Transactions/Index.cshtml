@model List<TransactionViewModel>

@{
    ViewData["Title"] = "Transactions Management";
    var categories = ViewBag.Categories as List<CategoryViewModel> ?? new List<CategoryViewModel>();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Transactions Management</h2>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createTransactionModal">
            <i class="bi bi-plus-circle"></i> Add New Transaction
        </button>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" style="width: 8%;">ID</th>
                        <th scope="col" style="width: 20%;">Transaction Name</th>
                        <th scope="col" style="width: 12%;">Amount</th>
                        <th scope="col" style="width: 12%;">Type</th>
                        <th scope="col" style="width: 15%;">Date</th>
                        <th scope="col" style="width: 13%;">Category</th>
                        <th scope="col" style="width: 10%;">Note</th>
                        <th scope="col" style="width: 10%;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="transactionsTableBody">
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td>@item.Id</td>
                            <td class="fw-semibold">@item.TransactionName</td>
                            <td class="@(item.TransactionType == "Income" ? "text-success fw-bold" : "text-danger fw-bold")">
                                @(item.TransactionType == "Income" ? "+" : "-")@item.Amount.ToString("N0") VND
                            </td>
                            <td>
                                @if (item.TransactionType == "Income")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Income</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Expense</span>
                                }
                            </td>
                            <td>@item.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge bg-secondary">@item.CategoryName</span>
                            </td>
                            <td class="text-muted small">@item.Note</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1" onclick="openEditModal(@item.Id)">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteTransaction(@item.Id)">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thêm Mới Transaction -->
<div class="modal fade" id="createTransactionModal" tabindex="-1" aria-labelledby="createTransactionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createTransactionModalLabel">Add New Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createTransactionForm">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="transTitle" class="form-label">Transaction Title</label>
                        <input type="text" class="form-control" id="transTitle" required>
                    </div>
                    <div class="mb-3">
                        <label for="transAmount" class="form-label">Amount (VND)</label>
                        <input type="number" step="1" min="1" class="form-control" id="transAmount" required>
                    </div>
                    <div class="mb-3">
                        <label for="transType" class="form-label">Transaction Type</label>
                        <select class="form-select" id="transType" required>
                            <option value="1">Income</option>
                            <option value="2">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="transDate" class="form-label">Transaction Date</label>
                        <input type="datetime-local" class="form-control" id="transDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="transCategory" class="form-label">Category</label>
                        <select class="form-select" id="transCategory" required>
                            <option value="" disabled selected>Select Category</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="transNote" class="form-label">Note</label>
                        <textarea class="form-control" id="transNote" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Transaction</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa Transaction -->
<div class="modal fade" id="editTransactionModal" tabindex="-1" aria-labelledby="editTransactionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTransactionModalLabel">Edit Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editTransactionForm">
                <input type="hidden" id="editTransId">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editTransTitle" class="form-label">Transaction Title</label>
                        <input type="text" class="form-control" id="editTransTitle" required>
                    </div>
                    <div class="mb-3">
                        <label for="editTransAmount" class="form-label">Amount (VND)</label>
                        <input type="number" step="1" min="1" class="form-control" id="editTransAmount" required>
                    </div>
                    <div class="mb-3">
                        <label for="editTransType" class="form-label">Transaction Type</label>
                        <select class="form-select" id="editTransType" required>
                            <option value="1">Income</option>
                            <option value="2">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editTransDate" class="form-label">Transaction Date</label>
                        <input type="datetime-local" class="form-control" id="editTransDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="editTransCategory" class="form-label">Category</label>
                        <select class="form-select" id="editTransCategory" required>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id">@cat.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editTransNote" class="form-label">Note</label>
                        <textarea class="form-control" id="editTransNote" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = "https://localhost:7271/api/transactions";

        // Set default date to now in local time for create form
        document.getElementById('createTransactionModal').addEventListener('show.bs.modal', function () {
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            document.getElementById('transDate').value = now.toISOString().slice(0, 16);
        });

        // 1. DELETE TRANSACTION
        async function deleteTransaction(id) {
            if (confirm("Are you sure you want to delete this transaction?")) {
                try {
                    const response = await fetch(`${API_BASE_URL}/${id}`, {
                        method: 'DELETE'
                    });

                    if (response.ok) {
                        const row = document.getElementById(`row-${id}`);
                        if (row) {
                            row.remove();
                        }
                        alert("Deleted successfully!");
                    } else {
                        alert("Failed to delete transaction.");
                    }
                } catch (error) {
                    console.error("Error:", error);
                    alert("An error occurred.");
                }
            }
        }

        // 2. CREATE TRANSACTION
        document.getElementById('createTransactionForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const title = document.getElementById('transTitle').value;
            const amount = parseFloat(document.getElementById('transAmount').value);
            const type = parseInt(document.getElementById('transType').value);
            const date = document.getElementById('transDate').value;
            const categoryId = parseInt(document.getElementById('transCategory').value);
            const note = document.getElementById('transNote').value;

            try {
                const response = await fetch(API_BASE_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        title: title,
                        amount: amount,
                        type: type,
                        transactionDate: date,
                        note: note,
                        categoryId: categoryId
                    })
                });

                if (response.ok) {
                    const newTrans = await response.json();

                    // Format date to local string
                    const formattedDate = new Date(newTrans.transactionDate).toLocaleString('sv-SE').slice(0, 16);

                    // Insert to Table
                    const tbody = document.getElementById('transactionsTableBody');
                    const isIncome = newTrans.transactionType === "Income";
                    const newRow = `
                        <tr id="row-${newTrans.id}">
                            <td>${newTrans.id}</td>
                            <td class="fw-semibold">${newTrans.transactionName}</td>
                            <td class="${isIncome ? 'text-success fw-bold' : 'text-danger fw-bold'}">
                                ${isIncome ? '+' : '-'}${parseFloat(newTrans.amount).toLocaleString('en-US')} VND
                            </td>
                            <td>
                                <span class="badge ${isIncome ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'}">
                                    ${newTrans.transactionType}
                                </span>
                            </td>
                            <td>${formattedDate}</td>
                            <td>
                                <span class="badge bg-secondary">${newTrans.categoryName}</span>
                            </td>
                            <td class="text-muted small">${newTrans.note ?? ''}</td>
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm me-1" onclick="openEditModal(${newTrans.id})">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button class="btn btn-danger btn-sm" onclick="deleteTransaction(${newTrans.id})">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.insertAdjacentHTML('beforeend', newRow);

                    // Reset and Close
                    document.getElementById('createTransactionForm').reset();
                    const modalEl = document.getElementById('createTransactionModal');
                    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.hide();

                    alert("Added new transaction successfully!");
                } else {
                    const errorText = await response.text();
                    alert("Failed to add transaction: " + errorText);
                }
            } catch (error) {
                console.error("Error:", error);
                alert("An error occurred while creating transaction.");
            }
        });

        // 3. OPEN EDIT MODAL
        async function openEditModal(id) {
            try {
                const response = await fetch(`${API_BASE_URL}/${id}`);
                if (response.ok) {
                    const trans = await response.json();

                    document.getElementById('editTransId').value = trans.id;
                    document.getElementById('editTransTitle').value = trans.transactionName;
                    document.getElementById('editTransAmount').value = parseInt(trans.amount);
                    
                    // Map "Income"/"Expense" to 1/2 for Select Option
                    document.getElementById('editTransType').value = trans.transactionType === "Income" ? "1" : "2";
                    
                    // Format Date to yyyy-MM-ddTHH:mm for local datetime input
                    const rawDate = new Date(trans.transactionDate);
                    rawDate.setMinutes(rawDate.getMinutes() - rawDate.getTimezoneOffset());
                    document.getElementById('editTransDate').value = rawDate.toISOString().slice(0, 16);
                    
                    document.getElementById('editTransCategory').value = trans.categoryId;
                    document.getElementById('editTransNote').value = trans.note ?? '';

                    const modalEl = document.getElementById('editTransactionModal');
                    const modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.show();
                } else {
                    alert("Failed to retrieve transaction details.");
                }
            } catch (error) {
                console.error("Error:", error);
                alert("An error occurred while loading transaction details.");
            }
        }

        // 4. SUBMIT EDIT TRANSACTION
        document.getElementById('editTransactionForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const id = document.getElementById('editTransId').value;
            const title = document.getElementById('editTransTitle').value;
            const amount = parseFloat(document.getElementById('editTransAmount').value);
            const type = parseInt(document.getElementById('editTransType').value);
            const date = document.getElementById('editTransDate').value;
            const categoryId = parseInt(document.getElementById('editTransCategory').value);
            const note = document.getElementById('editTransNote').value;

            // Get selected Category Name text for dynamic DOM update
            const categorySelect = document.getElementById('editTransCategory');
            const categoryName = categorySelect.options[categorySelect.selectedIndex].text;

            try {
                // Note: The PUT endpoint uses TransactionCreateDto, so property is 'notes', not 'note'!
                const response = await fetch(`${API_BASE_URL}/${id}`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        title: title,
                        amount: amount,
                        transactionDate: date,
                        notes: note,
                        type: type,
                        categoryId: categoryId
                    })
                });

                if (response.ok) {
                    // Update table row DOM
                    const row = document.getElementById(`row-${id}`);
                    if (row) {
                        const isIncome = type === 1;
                        
                        // Update Columns
                        row.cells[1].innerText = title;
                        
                        // Update Amount Cell
                        const amountCell = row.cells[2];
                        amountCell.className = isIncome ? 'text-success fw-bold' : 'text-danger fw-bold';
                        amountCell.innerText = `${isIncome ? '+' : '-'}${amount.toLocaleString('en-US')} VND`;

                        // Update Type Badge Cell
                        const badgeCell = row.cells[3];
                        badgeCell.innerHTML = `
                            <span class="badge ${isIncome ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle'}">
                                ${isIncome ? 'Income' : 'Expense'}
                            </span>
                        `;

                        // Update Date Cell
                        const formattedDate = new Date(date).toLocaleString('sv-SE').slice(0, 16);
                        row.cells[4].innerText = formattedDate;

                        // Update Category Cell
                        row.cells[5].innerHTML = `<span class="badge bg-secondary">${categoryName}</span>`;

                        // Update Note Cell
                        row.cells[6].innerText = note;
                    }

                    // Close Modal
                    const modalEl = document.getElementById('editTransactionModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    alert("Updated transaction successfully!");
                } else {
                    const errorText = await response.text();
                    alert("Failed to update transaction: " + errorText);
                }
            } catch (error) {
                console.error("Error:", error);
                alert("An error occurred while updating transaction.");
            }
        });
    </script>
}
